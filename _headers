/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=0, must-revalidate

# Fonts and images keep the same file names, so cache them for a week (and refresh quietly in the background).
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/downloads/*
  Content-Disposition: attachment

# The apps' Check for Updates button: always get the newest list.
/updates.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

# The "under development" page (only used if the site is locked down again).
/maintenance.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# The admin page is private: never cached, never indexed.
/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
